TOOL_INST       := $(shell taste-config --prefix)

all: node_1_p1 node_2_p1

check_stack:
	# Check stack usage for all tasks of all nodes
	python3 ./checkAllStacks.py

# Generate a dynamic library excluding the runtime for each node
simu: node_1_simu node_2_simu


run:	run_partition_1_partition run_partition_2_partition


ocarina:  # call Ocarina for POHI targets
	$(warning PolyORB-HI is not a target of this system)

DriversConfig/drivers_config.h:	drivers_config.asn
	mkdir -p DriversConfig
	asn1scc -o DriversConfig -c drivers_config.asn /home/taste/tool-inst/include/TASTE-SAMRH71-RTEMS-Drivers/configurations/samrh71-rtems-serial-driver.asn

check_targets:  # check that runtime of every node is installed
	check_deployment_target_cli.py samrh71_rtems
	check_deployment_target_cli.py samrh71_rtems


# Build of node node_1 for PLATFORM_SAMRH71_RTEMS
# (rule generated by templates/concurrency_view/aadl_4_makefile/node.tmplt)

node_1_p1: partition_1_glue DriversConfig/drivers_config.h
	$(MAKE) -C node_1 -f Makefile.node_1



#  Build of partition partition_1 (common to all targets)
# (rule generated by templates/concurrency_view/aadl_4_makefile/partition.tmplt)


# CPU PLATFORM: PLATFORM_SAMRH71_RTEMS
partition_1_glue:	datacompressor  datauncompressor  testcompressuncompress

	touch $@



run_partition_1_partition:
	echo "Execution platform PLATFORM_SAMRH71_RTEMS is not compatible with the host OS"


datacompressor:
	touch $@
ifneq ($(wildcard ../datacompressor/C/src/Makefile),)
	make -C ../datacompressor/C/src -f Makefile
endif
	@# If you need to add a call to a code generator, or anything else
	@# related to functions in C, edit the following template:
	@# $(KAZOO_SRC)/templates/concurrency_view/aadl_4_makefile/block.tmplt
	@# Placeholder if anything has to be done for this function coded in C


datauncompressor:
	touch $@
ifneq ($(wildcard ../datauncompressor/C/src/Makefile),)
	make -C ../datauncompressor/C/src -f Makefile
endif
	@# If you need to add a call to a code generator, or anything else
	@# related to functions in C, edit the following template:
	@# $(KAZOO_SRC)/templates/concurrency_view/aadl_4_makefile/block.tmplt
	@# Placeholder if anything has to be done for this function coded in C


testcompressuncompress:
	touch $@
ifneq ($(wildcard ../testcompressuncompress/C/src/Makefile),)
	make -C ../testcompressuncompress/C/src -f Makefile
endif
	@# If you need to add a call to a code generator, or anything else
	@# related to functions in C, edit the following template:
	@# $(KAZOO_SRC)/templates/concurrency_view/aadl_4_makefile/block.tmplt
	@# Placeholder if anything has to be done for this function coded in C


# Build of node node_2 for PLATFORM_SAMRH71_RTEMS
# (rule generated by templates/concurrency_view/aadl_4_makefile/node.tmplt)

node_2_p1: partition_2_glue DriversConfig/drivers_config.h
	$(MAKE) -C node_2 -f Makefile.node_2



#  Build of partition partition_2 (common to all targets)
# (rule generated by templates/concurrency_view/aadl_4_makefile/partition.tmplt)


# CPU PLATFORM: PLATFORM_SAMRH71_RTEMS
partition_2_glue:	uartotherend
	args=$$(python3 -c "import os, sys; print(' '.join({os.path.basename(f):f for f in sys.argv[1:]}.values()))" ${wildcard ../uartotherend/SDL/code/uartotherend_datamodel.asn} ${wildcard ../uartotherend/SDL/Context-uartotherend.asn}); \
	args2=$$(taste-check-for-updated-c-datamodels ../dataview/C $$args); mkdir -p ..\/dataview\/sdl_c_dataviews; asn1scc -c -ig -equal -typePrefix asn1Scc -o ..\/dataview\/sdl_c_dataviews $$args2 ../dataview/dataview-uniq.asn ;\
	for each in $$args2; do mv ../dataview/sdl_c_dataviews/$$(basename $${each%.*}.h) ../dataview/C; done;\
	rm -rf ..\/dataview\/sdl_c_dataviews

	touch $@



run_partition_2_partition:
	echo "Execution platform PLATFORM_SAMRH71_RTEMS is not compatible with the host OS"


TARGET_UARTOTHEREND = ../uartotherend/SDL/code/UartOtherEnd.c
uartotherend:	${TARGET_UARTOTHEREND}
	touch $@


${TARGET_UARTOTHEREND}: ../uartotherend/SDL/src/uartotherend.pr ../uartotherend/SDL/src/system_structure.pr ../uartotherend/SDL/src/dataview.md5
	# Call opengeode to generate the functional code
	$(MAKE) -j -C ../uartotherend/SDL generate-code


clean:
	$(MAKE) -C node_1 -f Makefile.node_1 clean
	rm -rf *_adainit deploymentview_final
	$(MAKE) -C node_2 -f Makefile.node_2 clean
	rm -rf *_adainit deploymentview_final

.PHONY:	clean simu run $(IF_PROPERTIES)

