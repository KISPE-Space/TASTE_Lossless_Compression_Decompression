PACKAGE deploymentview::DV::Node_Linux
PUBLIC

WITH Taste;
WITH Deployment;
WITH TASTE_DV_Properties;
WITH deploymentview::DV;
WITH Memory_Properties;
WITH ARINC653;

PROCESS demo
END demo;

PROCESS IMPLEMENTATION demo.others
END demo.others;

END deploymentview::DV::Node_Linux;

PACKAGE deploymentview::DV
PUBLIC

WITH interfaceview::IV::DataUncompressor;

WITH interfaceview::IV::DataCompressor;

WITH interfaceview::IV::UartOtherEnd;

WITH interfaceview::IV::TestCompressUncompress;


WITH ocarina_processors_x86;
WITH deploymentview::DV::Node_Linux;
WITH Taste;
WITH Deployment;
WITH interfaceview::IV;
WITH TASTE_DV_Properties;

SYSTEM Node_Linux
END Node_Linux;

SYSTEM IMPLEMENTATION Node_Linux.others
SUBCOMPONENTS
   IV_DataUncompressor : SYSTEM interfaceview::IV::DataUncompressor::DataUncompressor.others {
      Taste::FunctionName => "DataUncompressor";
   };

   IV_DataCompressor : SYSTEM interfaceview::IV::DataCompressor::DataCompressor.others {
      Taste::FunctionName => "DataCompressor";
   };

   IV_UartOtherEnd : SYSTEM interfaceview::IV::UartOtherEnd::UartOtherEnd.others {
      Taste::FunctionName => "UartOtherEnd";
   };

   IV_TestCompressUncompress : SYSTEM interfaceview::IV::TestCompressUncompress::TestCompressUncompress.others {
      Taste::FunctionName => "TestCompressUncompress";
   };

   demo : PROCESS deploymentview::DV::Node_Linux::demo.others {
      Deployment::Port_Number => 0;
      TASTE_DV_Properties::CoverageEnabled => false;
      TASTE::CFlags => "-no-pie";
      TASTE::LDFlags => "-no-pie";
   };
   x86_linux : PROCESSOR ocarina_processors_x86::x86.generic_linux;
PROPERTIES
   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_DataUncompressor;
   
   
   
   
   
   
   

   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_DataCompressor;
   
   
   
   
   
   
   

   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_UartOtherEnd;
   
   
   
   
   
   
   

   
   Taste::APLC_Binding => (reference (demo)) APPLIES TO IV_TestCompressUncompress;
   
   
   
   
   
   
   

   Actual_Processor_Binding => (reference (x86_linux)) APPLIES TO demo;
END Node_Linux.others;

SYSTEM deploymentview
END deploymentview;

SYSTEM IMPLEMENTATION deploymentview.others
SUBCOMPONENTS
  Node_Linux : SYSTEM Node_Linux.others;
  interfaceview : SYSTEM interfaceview::IV::interfaceview.others;
END deploymentview.others;

PROPERTIES
  Taste::coordinates => "0 0 297000 210000";
  Taste::version => "3.0";
  Taste::interfaceView => "InterfaceView.aadl";
  Taste::HWLibraries => ("ocarina_components.aadl");
END deploymentview::DV;